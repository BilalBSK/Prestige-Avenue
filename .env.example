# Local dev: DATABASE_URL = DIRECT_URL = ton Postgres local
# Vercel/Neon: DATABASE_URL = pooled (pgbouncer=true), DIRECT_URL = non-pooled (pour migrations)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/prestige_avenue?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/prestige_avenue?schema=public"

NEXTAUTH_SECRET="replace-with-strong-secret"
NEXTAUTH_URL="http://localhost:3000"

# Cloudflare R2 (stockage médias — S3-compatible, egress gratuit illimité)
# 1. Bucket existant : "prestige-avenue" (token API : Object Read & Write).
# 2. DEV / PREVIEW : le sous-domaine pub-xxx.r2.dev suffit (valeur ci-dessous).
# 3. VRAI LANCEMENT seulement : brancher un domaine custom devant le bucket et
#    mettre cette URL dans R2_PUBLIC_BASE_URL (le r2.dev est rate-limité, sans
#    cache CDN). Procédure pas-à-pas : docs/r2-production-setup.md
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET="prestige-avenue"
# Dev/preview : "https://pub-xxxxxxxx.r2.dev"  —  Prod : "https://media.le-domaine.com"
R2_PUBLIC_BASE_URL="https://pub-xxxxxxxx.r2.dev"
