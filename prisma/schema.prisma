generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  USER
  ADMIN
}

enum CarStatus {
  AVAILABLE
  MAINTENANCE
  DISABLED
}

enum BookingStatus {
  PENDING_REVIEW
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  DECLINED
}

enum CarCategory {
  CITADINE
  COMPACTE
  BERLINE
  SUV
  COUPE
  CABRIOLET
  SPORTIVE
}

enum Transmission {
  MANUAL
  AUTOMATIC
}

enum FuelType {
  PETROL
  DIESEL
  HYBRID
  PLUG_IN_HYBRID
  ELECTRIC
}

// Origine d'une réservation. WEBSITE = demande publique via le site ;
// PHONE / IN_PERSON = saisie manuelle par l'agence (hors paiement en ligne).
enum BookingSource {
  WEBSITE
  PHONE
  IN_PERSON
}

// Suivi du règlement hors-ligne (aucun paiement en ligne sur le site).
// Le solde se règle sur place à la remise des clés.
enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

// Moyen de règlement encaissé par l'agence.
enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  CHECK
  OTHER
}

model User {
  id        String    @id @default(cuid())
  name      String
  // Nullable : un client enregistré par téléphone peut ne pas avoir d'e-mail.
  // Postgres autorise plusieurs NULL sous un index @unique ; l'auth ne requête
  // que des e-mails non-nuls validés, la connexion n'est donc pas affectée.
  email     String?   @unique
  password  String
  role      Role      @default(USER)
  phone     String?
  createdAt DateTime  @default(now())
  bookings  Booking[]

  @@index([createdAt])
}

model Car {
  id                         String       @id @default(cuid())
  slug                       String       @unique
  brand                      String
  model                      String
  trim                       String?
  year                       Int
  category                   CarCategory

  power                      Int
  transmission               Transmission
  fuelType                   FuelType
  seats                      Int          @default(5)
  doors                      Int          @default(5)

  pricePerDay                Decimal      @db.Decimal(10, 2)
  pricePerKm                 Decimal?     @db.Decimal(10, 2)
  includedKmPerDay           Int?
  // Forfait week-end 48h : vendredi→dimanche OU samedi→lundi (2 jours).
  weekendPackagePrice48h     Decimal?     @db.Decimal(10, 2)
  weekendPackageIncludedKm48h Int?
  // Forfait week-end 72h : vendredi→lundi (3 jours).
  weekendPackagePrice72h     Decimal?     @db.Decimal(10, 2)
  weekendPackageIncludedKm72h Int?
  depositAmount              Decimal      @db.Decimal(10, 2)

  minDriverAge               Int          @default(21)
  minLicenseYears            Int          @default(2)

  shortTagline               String?
  description                String
  highlights                 String[]
  features                   Json         @default("[]")

  mainImage                  String
  // Galerie héritée (plat, sans angle). Conservée comme repli d'affichage
  // pour les véhicules pas encore re-catalogués par prises de vue.
  galleryImages              String[]
  // Prises de vue cataloguées par angle : [{ angle: "EXT_PROFILE", images: [url, …] }].
  // Source d'affichage principale du studio photo (cf. src/lib/cars/shots.ts).
  galleryShots               Json         @default("[]")
  videoUrl                   String?

  status                     CarStatus    @default(AVAILABLE)
  isFeatured                 Boolean      @default(false)
  displayOrder               Int          @default(0)
  createdAt                  DateTime     @default(now())
  updatedAt                  DateTime     @updatedAt

  bookings                   Booking[]
  blockedDates               BlockedDate[]

  @@index([status])
  @@index([isFeatured, displayOrder])
  @@index([category, status])
  @@index([createdAt])
}

model Booking {
  id               String        @id @default(cuid())
  userId           String
  carId            String
  startDate        DateTime
  endDate          DateTime
  totalPrice       Decimal       @db.Decimal(10, 2)
  status           BookingStatus @default(PENDING_REVIEW)
  source           BookingSource @default(WEBSITE)
  customerMessage  String?
  declineReason    String?
  // Note interne de l'agence — invisible côté client, distincte de customerMessage.
  internalNote     String?
  // Suivi du règlement hors-ligne.
  paymentStatus    PaymentStatus @default(UNPAID)
  amountPaid       Decimal       @default(0) @db.Decimal(10, 2)
  paymentMethod    PaymentMethod?
  paymentNote      String?
  submissionToken  String?       @unique
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  car              Car           @relation(fields: [carId], references: [id], onDelete: Restrict)

  @@index([carId, startDate, endDate])
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([startDate, endDate])
}

model BlockedDate {
  id        String   @id @default(cuid())
  carId     String
  startDate DateTime
  endDate   DateTime
  reason    String
  car       Car      @relation(fields: [carId], references: [id], onDelete: Cascade)

  @@index([carId, startDate, endDate])
}

model Collaboration {
  id           String   @id @default(cuid())
  partnerName  String
  partnerUrl   String?
  // [{ url, width, height }] — dimensions captured à l'upload pour un rendu
  // sans saut de mise en page quelle que soit l'orientation de la photo.
  photos       Json     @default("[]")
  isPublished  Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isPublished, displayOrder])
}
